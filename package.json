{
  "name": "my-steam-profil",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r run typecheck",
    "check:tests": "pnpm --filter @steam/repo-checks check",
    "build:web": "pnpm --filter @steam/mobile exec expo export --platform web",
    "test:domain": "pnpm --filter @steam/domain test",
    "test:api": "pnpm --filter @steam/api test",
    "coverage:domain": "pnpm --filter @steam/domain coverage",
    "fixtures:build": "pnpm --filter @steam/fixtures-dto build",
    "dev:api": "pnpm --filter @steam/api dev",
    "tdd": "pnpm --filter @steam/domain test:watch",
    "prototype": "pnpm --filter @steam/mobile exec expo start --web --clear"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
