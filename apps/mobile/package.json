{
  "name": "@steam/mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@steam/contracts": "workspace:*",
    "@steam/domain": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@sentry/cli": "3.8.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-native-web-vite": "^10.6.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "storybook": "^10.6.0",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "wrangler": "^4.125.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC jest --coverage",
    "test:watch": "TZ=UTC jest --watch"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./src/i18n/i18n.ts",
      "./src/query/answers-in-the-same-turn.test-support.ts"
    ],
    "testMatch": [
      "**/src/**/*.test.ts",
      "**/src/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|standard-navigation|storybook|@storybook))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 96,
        "branches": 90,
        "functions": 96,
        "lines": 96
      }
    }
  }
}
