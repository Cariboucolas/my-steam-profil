# The Steam profile this build shows. Public data, not a secret.
EXPO_PUBLIC_STEAM_ID=

# Where apps/api is listening. Defaults to http://localhost:3000.
# On a phone, localhost is the phone itself — use your machine's LAN address,
# for example http://192.168.1.10:3000
# EXPO_PUBLIC_API_URL=http://localhost:3000
