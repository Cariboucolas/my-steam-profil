# Optional. The Steam profile a fresh install starts on: a SteamID64, seventeen
# digits. Leave it empty and the app asks on first launch, which is what a
# deployed build does. Public data, not a secret — find yours at steamid.io
EXPO_PUBLIC_STEAM_ID=

# Where apps/api is listening.
# On a phone, localhost is the phone itself — use the LAN address of the
# machine running the backend, for example http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
